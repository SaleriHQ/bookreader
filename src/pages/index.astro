---
import { getCollection } from "astro:content";

import { getBookId, sortChapters } from "../lib/books";
import "../styles/tokens.css";
import "../styles/global.css";

const books = await getCollection("books");
const chapters = await getCollection("chapters");

const shelf = books.map((book) => {
    const bookChapters = sortChapters(
        chapters.filter((chapter) => getBookId(chapter) === book.id),
    );
    const firstChapter = bookChapters[0];

    return {
        ...book,
        chapterCount: bookChapters.length,
        href: firstChapter ? `/books/${firstChapter.id}` : "#",
    };
});
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="我的在线阅读书架" />
        <title>我的书架</title>
    </head>
    <body>
        <main class="library">
            <header class="library-header">
                <a class="brand" href="/" aria-label="返回我的书架">
                    <span class="brand-mark" aria-hidden="true">阅</span>
                    <span>我的书架</span>
                </a>
                <span class="book-total">{shelf.length} 本藏书</span>
            </header>

            <section class="hero" aria-labelledby="library-title">
                <p class="eyebrow">MY READING ROOM</p>
                <h1 id="library-title">今天，读点什么？</h1>
                <p>把想读的书放在手边，在安静的页面里继续上次的思考。</p>
            </section>

            <section class="shelf-section" aria-labelledby="shelf-title">
                <div class="section-heading">
                    <div>
                        <p class="section-kicker">COLLECTION</p>
                        <h2 id="shelf-title">全部书籍</h2>
                    </div>
                    <span>选择封面开始阅读</span>
                </div>

                <div class="book-grid">
                    {
                        shelf.map((book) => (
                            <article class="book-card">
                                <a class="cover-link" href={book.href} aria-label={`开始阅读 ${book.data.title}`}>
                                    <div class="cover-wrap">
                                        <img
                                            src={book.data.cover.src}
                                            alt={`${book.data.title} 封面`}
                                            width={book.data.cover.width}
                                            height={book.data.cover.height}
                                            loading="eager"
                                        />
                                        <span class="read-action">
                                            开始阅读
                                            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4 6 6-6 6" /></svg>
                                        </span>
                                    </div>
                                </a>

                                <div class="book-info">
                                    <div class="book-meta">
                                        <span>{book.chapterCount} 章</span>
                                        {book.data.author && <span>{book.data.author}</span>}
                                    </div>
                                    <h3><a href={book.href}>{book.data.title}</a></h3>
                                    {book.data.subtitle && <p>{book.data.subtitle}</p>}
                                    <a class="continue-link" href={book.href}>
                                        <span>打开阅读器</span>
                                        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4 6 6-6 6" /></svg>
                                    </a>
                                </div>
                            </article>
                        ))
                    }
                </div>

                {shelf.length === 0 && <p class="empty-state">书架还是空的。</p>}
            </section>
        </main>
    </body>
</html>

<style>
    :global(body) {
        background: radial-gradient(circle at 82% 2%, rgba(184, 93, 57, 0.13), transparent 30rem), #f5f1e8;
        color: #292821;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .library { min-height: 100vh; }
    .library-header { display: flex; align-items: center; justify-content: space-between; width: min(1180px, calc(100% - 48px)); margin-inline: auto; padding-block: 28px; border-bottom: 1px solid rgba(54, 51, 42, 0.14); }
    .brand { display: inline-flex; align-items: center; gap: 12px; color: inherit; font-weight: 750; text-decoration: none; letter-spacing: .02em; }
    .brand-mark { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: #263b33; color: #faf6ec; font-family: ui-serif, Georgia, serif; }
    .book-total { color: #777165; font-size: 14px; }
    .hero { width: min(1180px, calc(100% - 48px)); margin-inline: auto; padding: clamp(64px, 10vw, 128px) 0 clamp(72px, 8vw, 104px); }
    .eyebrow, .section-kicker { margin: 0 0 14px; color: #af5234; font-size: 11px; font-weight: 800; letter-spacing: .2em; }
    .hero h1 { max-width: 900px; margin: 0; font-family: ui-serif, "Noto Serif SC", "Songti SC", Georgia, serif; font-size: clamp(50px, 8vw, 92px); font-weight: 500; line-height: 1.08; letter-spacing: -.04em; }
    .hero > p:last-child { max-width: 560px; margin: 28px 0 0; color: #6e6a5f; font-family: ui-serif, "Noto Serif SC", serif; font-size: 18px; line-height: 1.8; }
    .shelf-section { padding-bottom: 100px; }
    .section-heading { display: flex; align-items: flex-end; justify-content: space-between; width: min(1180px, calc(100% - 48px)); margin: 0 auto 34px; padding-bottom: 20px; border-bottom: 1px solid rgba(54, 51, 42, .18); }
    .section-heading p { margin-bottom: 8px; }
    .section-heading h2 { margin: 0; font-family: ui-serif, "Noto Serif SC", serif; font-size: 30px; font-weight: 600; }
    .section-heading > span { color: #8a8579; font-size: 13px; }
    .book-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 500px), 1fr)); gap: 32px; width: min(1180px, calc(100% - 48px)); margin-inline: auto; }
    .book-card { display: grid; grid-template-columns: minmax(180px, 230px) minmax(0, 1fr); gap: clamp(24px, 4vw, 40px); padding: clamp(20px, 3vw, 30px); border: 1px solid rgba(54, 51, 42, .12); border-radius: 24px; background: rgba(255, 253, 247, .72); box-shadow: 0 24px 70px rgba(74, 62, 42, .08); }
    .cover-link { align-self: start; }
    .cover-wrap { position: relative; overflow: hidden; aspect-ratio: 3 / 4; border-radius: 5px 12px 12px 5px; background: #ddd5c4; box-shadow: -7px 8px 0 #e5ddcd, 0 24px 38px rgba(52, 45, 34, .24); transition: transform .25s ease, box-shadow .25s ease; }
    .cover-wrap::after { position: absolute; inset: 0 auto 0 0; width: 8px; content: ""; background: linear-gradient(90deg, rgba(20,20,20,.22), transparent); }
    .cover-wrap :global(img) { width: 100%; height: 100%; object-fit: cover; }
    .read-action { position: absolute; inset: auto 12px 12px; display: flex; align-items: center; justify-content: center; gap: 5px; padding: 11px 14px; border-radius: 999px; background: rgba(255, 253, 247, .94); color: #292821; font-size: 13px; font-weight: 700; opacity: 0; transform: translateY(8px); transition: opacity .2s ease, transform .2s ease; }
    .read-action svg, .continue-link svg { width: 17px; fill: none; stroke: currentColor; stroke-width: 1.7; }
    .cover-link:hover .cover-wrap { transform: translateY(-5px) rotate(-.5deg); box-shadow: -7px 13px 0 #e5ddcd, 0 30px 46px rgba(52, 45, 34, .28); }
    .cover-link:hover .read-action, .cover-link:focus-visible .read-action { opacity: 1; transform: translateY(0); }
    .book-info { align-self: center; min-width: 0; }
    .book-meta { display: flex; flex-wrap: wrap; gap: 6px 14px; color: #948d80; font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
    .book-info h3 { margin: 18px 0 8px; font-family: ui-serif, Georgia, serif; font-size: clamp(29px, 4vw, 42px); line-height: 1.05; }
    .book-info h3 a { color: inherit; text-decoration: none; }
    .book-info p { margin: 0 0 24px; color: #af5234; font-size: 13px; font-weight: 700; line-height: 1.6; }
    .continue-link { display: inline-flex; align-items: center; gap: 6px; color: #263b33; font-size: 13px; font-weight: 750; text-decoration: none; }
    .continue-link:hover { color: #af5234; }
    .empty-state { width: min(1180px, calc(100% - 48px)); margin-inline: auto; padding: 70px; border: 1px dashed #c9c0af; border-radius: 20px; color: #777166; text-align: center; }
    @media (max-width: 700px) {
        .library-header, .hero, .section-heading, .book-grid { width: min(100% - 32px, 1180px); }
        .library-header { padding-block: 20px; }
        .hero { padding-block: 60px 72px; }
        .hero h1 { font-size: clamp(46px, 16vw, 68px); }
        .section-heading > span { display: none; }
        .book-card { grid-template-columns: minmax(0, 1fr); }
        .cover-link { width: min(78%, 280px); margin-inline: auto; }
        .book-info { padding: 10px 4px 4px; }
    }
    @media (prefers-reduced-motion: reduce) {
        .cover-wrap, .read-action { transition: none; }
    }
</style>
