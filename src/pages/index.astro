---
import { getCollection } from "astro:content";

import { getBookId, sortChapters } from "../lib/books";
import "../styles/tokens.css";
import "../styles/global.css";

const books = await getCollection("books");
const chapters = await getCollection("chapters");

const shelf = books.map((book) => {
    const bookChapters = sortChapters(
        chapters.filter((chapter) => getBookId(chapter) === book.id),
    );
    const firstChapter = bookChapters[0];

    return {
        ...book,
        chapterCount: bookChapters.length,
        href: firstChapter ? `/books/${firstChapter.id}` : "#",
    };
});
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="SaleriBook" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
        <title>我的书架</title>
    </head>
    <body>
        <header class="site-nav">
            <div class="nav-inner">
                <a class="site-brand" href="/">书架</a>
            </div>
        </header>
        <main class="library">
            <section id="books" aria-labelledby="books-title">
                <div class="book-list">
                    {shelf.map((book) => (
                        <article class="book-row">
                            <a class="cover-link" href={book.href} aria-label={`开始阅读 ${book.data.title}`}>
                                <img src={book.data.cover.src} alt={`${book.data.title} 封面`} width={book.data.cover.width} height={book.data.cover.height} loading="lazy" />
                            </a>
                            <div class="book-details">
                                <h3><a href={book.href}>{book.data.title}</a></h3>
                                {book.data.subtitle && <p class="subtitle">{book.data.subtitle}</p>}
                                <p class="book-meta">{book.data.author && <span>{book.data.author} · </span>}{book.chapterCount} 章</p>
                                <a class="read-link" href={book.href}>开始阅读 →</a>
                            </div>
                        </article>
                    ))}
                </div>
                {shelf.length === 0 && <p class="empty-state">书架还是空的。</p>}
            </section>
        </main>
    </body>
</html>

<style>
    :global(html) { scroll-behavior: smooth; scroll-padding-top: 70px; }
    :global(body) { background: #fff; color: #333; font: 15px/1.55 "Work Sans", "Noto Sans SC", Arial, sans-serif; }
    :global(a) { color: #0072c1; }
    :global(a:hover) { color: #204f78; }
    .site-nav { position: fixed; z-index: 10; inset: 0 0 auto; height: 50px; background: #026ebb; font-family: Roboto, "Noto Sans SC", Arial, sans-serif; }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; width: min(100%, 1440px); height: 100%; margin: auto; padding: 0 clamp(20px, 8vw, 150px); }
    .site-brand { color: #fff; font-size: 18px; font-weight: 700; text-decoration: none; }
    .site-nav nav { height: 100%; }
    .site-nav nav a { display: grid; place-items: center; height: 100%; padding: 0 14px; color: #ecf0f1; font-size: 14px; text-decoration: none; }
    .site-nav nav a:hover { background: #0085e1; color: #fff; }
    .library { width: min(100%, 1440px); margin: 50px auto 0; padding: 0 clamp(20px, 8vw, 150px) 90px; }
    .page-header { margin: 64px 0 54px; }
    .page-header h1 { margin: 0 0 16px; padding: 0 0 13px; border-bottom: 1px solid #eee; color: #0072c1; font: 300 clamp(34px, 4vw, 42px)/1.2 Roboto, "Noto Sans SC", Arial, sans-serif; }
    .page-header p { margin: 0; }
    section h2 { margin: 0 0 18px; font: 400 30px/1.2 Roboto, "Noto Sans SC", Arial, sans-serif; }
    .book-list { border-top: 1px solid #eee; }
    .book-row { display: flex; align-items: flex-start; gap: 28px; padding: 26px 0; border-bottom: 1px solid #eee; }
    .cover-link { flex: none; width: 110px; }
    .cover-link img { display: block; width: 100%; height: auto; border: 1px solid #ddd; }
    .book-details h3 { margin: 0 0 6px; font: 500 23px/1.25 Roboto, "Noto Sans SC", Arial, sans-serif; }
    .book-details h3 a { text-decoration: none; }
    .book-details h3 a:hover { text-decoration: underline; }
    .subtitle { margin: 0 0 8px; }
    .book-meta { margin: 0 0 12px; color: #777; font-size: 13px; }
    .read-link { font-size: 14px; }
    .empty-state { padding: 30px 0; color: #777; }
    @media (max-width: 600px) {
        .nav-inner, .library { padding-left: 20px; padding-right: 20px; }
        .page-header { margin: 40px 0; }
        .book-row { gap: 18px; }
        .cover-link { width: 82px; }
        .book-details h3 { font-size: 20px; }
    }
</style>
