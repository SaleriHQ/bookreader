---
import {
    getCollection,
    render,
    type CollectionEntry,
} from "astro:content";

import ReaderLayout from "../../layouts/ReaderLayout.astro";
import { getBookId, humanizeBookId, sortChapters } from "../../lib/books";

interface Props {
    chapter: CollectionEntry<"chapters">;
}

export async function getStaticPaths() {
    const chapters = await getCollection("chapters");
    
    return chapters.map((chapter) => ({
        params: {
            slug: chapter.id,
        },
        props: {
            chapter,
        },
    }));
}

const { chapter } = Astro.props as Props;

const { Content, headings } = await render(chapter);

const bookId = getBookId(chapter);
const book = (await getCollection("books")).find((entry) => entry.id === bookId);
const chapters = sortChapters(
    (await getCollection("chapters")).filter((entry) => getBookId(entry) === bookId),
).map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    href: `/books/${entry.id}`,
}));
---

<ReaderLayout
    title={chapter.data.title}
    bookTitle={book?.data.title ?? humanizeBookId(bookId)}
    bookId={bookId}
    chapterId={chapter.id}
    chapters={chapters}
    headings={headings}
>
    <Content />
</ReaderLayout>
