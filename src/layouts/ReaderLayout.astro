---
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/reader.css";

interface Props {
    title: string;
    bookTitle: string;
    bookId?: string;
    chapterId?: string;
    chapters: Array<{ id: string; title: string; href: string }>;
    headings: Array<{ depth: number; slug: string; text: string }>;
    lang?: string;
}

const {
    title,
    bookTitle,
    bookId,
    chapterId,
    chapters,
    headings,
    lang = "en",
} = Astro.props;

const outline = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

<!doctype html>

<html lang={lang}>
    <head>
        <meta charset="UTF-8" />

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1"
        />

        <meta name="description" content={`${bookTitle} · ${title}`} />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@400;600&family=Roboto:wght@300;400;500;700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

        <title>{title} · {bookTitle}</title>
    </head>

    <body
        data-book-id={bookId}
        data-chapter-id={chapterId}
    >
        <div class="reading-progress" aria-hidden="true"><span></span></div>

        <header class="site-nav">
            <div class="nav-inner">
                <a class="site-brand" href="/" title="返回书架">{bookTitle}</a>
                <nav class="top-links" aria-label="主导航">
                    <button class="chapter-toggle" type="button" aria-label="收起章节目录" aria-expanded="true" aria-controls="chapter-sidebar" data-chapter-toggle>章节目录</button>
                    <button class="outline-toggle" type="button" aria-label="打开本章大纲" aria-expanded="false" aria-controls="chapter-outline" data-outline-toggle>本章大纲</button>
                </nav>
            </div>
        </header>

        <div class="reader-backdrop" data-reader-backdrop></div>

        <button class="sidebar-edge-toggle" type="button" aria-label="收起章节目录" aria-expanded="true" aria-controls="chapter-sidebar" data-sidebar-edge-toggle>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m12 4-6 6 6 6" /></svg>
        </button>
        <button class="outline-edge-toggle" type="button" aria-label="收起本章大纲" aria-expanded="true" aria-controls="chapter-outline" data-outline-edge-toggle>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m8 4 6 6-6 6" /></svg>
        </button>

        <div class="reader">
            <aside class="reader-sidebar" id="chapter-sidebar" aria-label="章节目录" data-chapter-sidebar>
                <nav class="chapter-nav">
                    <ol>
                        {
                            chapters.map((chapter, index) => (
                                <li>
                                    <a
                                        href={chapter.href}
                                        class:list={{ active: chapter.id === chapterId }}
                                        aria-current={chapter.id === chapterId ? "page" : undefined}
                                    >
                                        <span>{String(index + 1).padStart(2, "0")}</span>
                                        <strong>{chapter.title.replace(/^Chapter\s+\d+:\s*/i, "")}</strong>
                                    </a>
                                </li>
                            ))
                        }
                    </ol>
                </nav>
            </aside>

            <main class="reader-main">
                <div class="book-context"><a href="/">书架</a><span>/</span><span>{bookTitle}</span></div>
                <article class="reader-content">
                    <slot />
                </article>
            </main>

            <aside class="reader-outline" id="chapter-outline" aria-label="本章大纲" data-chapter-outline>
                <div class="outline-inner">
                    <div class="outline-heading">
                        <span>本章目录</span>
                        <strong data-progress-label>0%</strong>
                    </div>
                    <nav>
                        <ol>
                            {
                                outline.map((heading) => (
                                    <li class:list={{ nested: heading.depth === 3 }}>
                                        <a href={`#${heading.slug}`} data-outline-link={heading.slug}>{heading.text}</a>
                                    </li>
                                ))
                            }
                        </ol>
                    </nav>
                </div>
            </aside>

        </div>

        <script is:inline>
            (() => {
                document.querySelectorAll(".reader-content p").forEach((paragraph) => {
                    if (/^FIGURE\b/.test(paragraph.textContent?.trimStart() ?? "")) {
                        paragraph.classList.add("book-figure-caption");
                    }
                });

                const body = document.body;
                const chapterToggle = document.querySelector("[data-chapter-toggle]");
                const edgeToggle = document.querySelector("[data-sidebar-edge-toggle]");
                const outlineToggle = document.querySelector("[data-outline-toggle]");
                const outlineEdgeToggle = document.querySelector("[data-outline-edge-toggle]");
                const chapterSidebar = document.querySelector("[data-chapter-sidebar]");
                const chapterOutline = document.querySelector("[data-chapter-outline]");
                const backdrop = document.querySelector("[data-reader-backdrop]");
                const desktopNav = window.matchMedia("(min-width: 761px)");
                const outlineDrawer = window.matchMedia("(max-width: 1100px)");
                const storageKey = "reader-chapter-sidebar-collapsed";
                const savedCollapsed = localStorage.getItem(storageKey) === "true";

                const setChapterState = (open) => {
                    if (desktopNav.matches) {
                        body.dataset.navCollapsed = String(!open);
                        localStorage.setItem(storageKey, String(!open));
                    } else {
                        body.dataset.mobileNavOpen = String(open);
                    }
                    for (const toggle of [chapterToggle, edgeToggle]) {
                        toggle?.setAttribute("aria-expanded", String(open));
                        toggle?.setAttribute("aria-label", open ? "收起章节目录" : "展开章节目录");
                    }
                    if (chapterSidebar) chapterSidebar.inert = !open;
                };

                const setOutlineState = (open) => {
                    const visible = outlineDrawer.matches ? open : true;
                    body.dataset.outlineOpen = String(outlineDrawer.matches && visible);
                    for (const toggle of [outlineToggle, outlineEdgeToggle]) {
                        toggle?.setAttribute("aria-expanded", String(visible));
                        toggle?.setAttribute("aria-label", visible ? "收起本章大纲" : "展开本章大纲");
                    }
                    if (chapterOutline) chapterOutline.inert = !visible;
                };

                const closeDrawers = () => {
                    body.dataset.mobileNavOpen = "false";
                    body.dataset.outlineOpen = "false";
                    const chapterOpen = desktopNav.matches && body.dataset.navCollapsed !== "true";
                    for (const toggle of [chapterToggle, edgeToggle]) {
                        toggle?.setAttribute("aria-expanded", String(chapterOpen));
                        toggle?.setAttribute("aria-label", chapterOpen ? "收起章节目录" : "展开章节目录");
                    }
                    const outlineOpen = !outlineDrawer.matches;
                    for (const toggle of [outlineToggle, outlineEdgeToggle]) {
                        toggle?.setAttribute("aria-expanded", String(outlineOpen));
                        toggle?.setAttribute("aria-label", outlineOpen ? "收起本章大纲" : "展开本章大纲");
                    }
                    if (chapterSidebar) chapterSidebar.inert = !desktopNav.matches || body.dataset.navCollapsed === "true";
                    if (chapterOutline) chapterOutline.inert = !outlineOpen;
                };

                setChapterState(desktopNav.matches ? !savedCollapsed : false);
                setOutlineState(false);
                closeDrawers();

                const toggleChapters = () => {
                    const open = desktopNav.matches
                        ? body.dataset.navCollapsed === "true"
                        : body.dataset.mobileNavOpen !== "true";
                    closeDrawers();
                    setChapterState(open);
                };
                chapterToggle?.addEventListener("click", toggleChapters);
                edgeToggle?.addEventListener("click", toggleChapters);

                const toggleOutline = () => {
                    const open = body.dataset.outlineOpen !== "true";
                    closeDrawers();
                    setOutlineState(open);
                };
                outlineToggle?.addEventListener("click", toggleOutline);
                outlineEdgeToggle?.addEventListener("click", toggleOutline);
                backdrop?.addEventListener("click", closeDrawers);
                document.addEventListener("keydown", (event) => event.key === "Escape" && closeDrawers());
                desktopNav.addEventListener("change", () => {
                    closeDrawers();
                    setChapterState(desktopNav.matches ? localStorage.getItem(storageKey) !== "true" : false);
                });
                outlineDrawer.addEventListener("change", closeDrawers);
                document.querySelectorAll("[data-outline-link]").forEach((link) => {
                    link.addEventListener("click", closeDrawers);
                });

                const outlineLinks = [...document.querySelectorAll("[data-outline-link]")];
                const sections = outlineLinks
                    .map((link) => document.getElementById(link.dataset.outlineLink))
                    .filter(Boolean);
                let ticking = false;

                const updateReadingState = () => {
                    const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
                    const progress = maxScroll > 0 ? Math.min(100, Math.max(0, window.scrollY / maxScroll * 100)) : 100;
                    document.documentElement.style.setProperty("--reading-progress", `${progress}%`);
                    document.querySelectorAll("[data-progress-label]").forEach((label) => {
                        label.textContent = `${Math.round(progress)}%`;
                    });

                    let active = sections[0];
                    for (const section of sections) {
                        if (section.getBoundingClientRect().top <= window.innerHeight * .32) active = section;
                        else break;
                    }
                    outlineLinks.forEach((link) => {
                        const current = active && link.dataset.outlineLink === active.id;
                        link.classList.toggle("active", Boolean(current));
                        if (current) link.setAttribute("aria-current", "location");
                        else link.removeAttribute("aria-current");
                    });
                    ticking = false;
                };

                window.addEventListener("scroll", () => {
                    if (!ticking) {
                        requestAnimationFrame(updateReadingState);
                        ticking = true;
                    }
                }, { passive: true });
                updateReadingState();
            })();
        </script>
    </body>
</html>
