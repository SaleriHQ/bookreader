---
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/reader.css";

interface Props {
    title: string;
    bookTitle: string;
    bookId?: string;
    chapterId?: string;
    chapters: Array<{ id: string; title: string; href: string }>;
    headings: Array<{ depth: number; slug: string; text: string }>;
    lang?: string;
}

const {
    title,
    bookTitle,
    bookId,
    chapterId,
    chapters,
    headings,
    lang = "en",
} = Astro.props;

const outline = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

<!doctype html>

<html lang={lang}>
    <head>
        <meta charset="UTF-8" />

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1"
        />

        <meta name="description" content={`${bookTitle} · ${title}`} />

        <title>{title} · {bookTitle}</title>
    </head>

    <body
        data-book-id={bookId}
        data-chapter-id={chapterId}
    >
        <div class="reading-progress" aria-hidden="true"><span></span></div>

        <div class="reader-backdrop" data-reader-backdrop></div>

        <div class="reader">
            <aside class="reader-sidebar" aria-label="章节目录">
                <header class="sidebar-header">
                    <a class="shelf-link" href="/">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
                        <span>返回书架</span>
                    </a>
                    <p>{bookTitle}</p>
                </header>

                <nav class="chapter-nav">
                    <p class="nav-label">目录</p>
                    <ol>
                        {
                            chapters.map((chapter, index) => (
                                <li>
                                    <a
                                        href={chapter.href}
                                        class:list={{ active: chapter.id === chapterId }}
                                        aria-current={chapter.id === chapterId ? "page" : undefined}
                                    >
                                        <span>{String(index + 1).padStart(2, "0")}</span>
                                        <strong>{chapter.title.replace(/^Chapter\s+\d+:\s*/i, "")}</strong>
                                    </a>
                                </li>
                            ))
                        }
                    </ol>
                </nav>
            </aside>

            <button class="chapter-toggle" type="button" aria-label="收起章节目录" aria-expanded="true" data-chapter-toggle>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
            </button>

            <main class="reader-main">
                <article class="reader-content">
                    <slot />
                </article>
            </main>

            <aside class="reader-outline" aria-label="本章大纲">
                <div class="outline-inner">
                    <div class="outline-heading">
                        <span>本章大纲</span>
                        <strong data-progress-label>0%</strong>
                    </div>
                    <nav>
                        <ol>
                            {
                                outline.map((heading) => (
                                    <li class:list={{ nested: heading.depth === 3 }}>
                                        <a href={`#${heading.slug}`} data-outline-link={heading.slug}>{heading.text}</a>
                                    </li>
                                ))
                            }
                        </ol>
                    </nav>
                </div>
            </aside>

            <button class="outline-toggle" type="button" aria-label="打开本章大纲" aria-expanded="false" data-outline-toggle>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01" /></svg>
                <span data-progress-label>0%</span>
            </button>
        </div>

        <script is:inline>
            (() => {
                const body = document.body;
                const chapterToggle = document.querySelector("[data-chapter-toggle]");
                const outlineToggle = document.querySelector("[data-outline-toggle]");
                const backdrop = document.querySelector("[data-reader-backdrop]");
                const desktop = window.matchMedia("(min-width: 901px)");

                const setChapterState = (open) => {
                    if (desktop.matches) {
                        body.dataset.navCollapsed = String(!open);
                        localStorage.setItem("reader-nav-collapsed", String(!open));
                    } else {
                        body.dataset.mobileNavOpen = String(open);
                    }
                    chapterToggle?.setAttribute("aria-expanded", String(open));
                    chapterToggle?.setAttribute("aria-label", open ? "收起章节目录" : "展开章节目录");
                };

                const initialCollapsed = localStorage.getItem("reader-nav-collapsed") === "true";
                setChapterState(desktop.matches ? !initialCollapsed : false);

                chapterToggle?.addEventListener("click", () => {
                    const open = desktop.matches
                        ? body.dataset.navCollapsed === "true"
                        : body.dataset.mobileNavOpen !== "true";
                    setChapterState(open);
                });

                const closeDrawers = () => {
                    body.dataset.mobileNavOpen = "false";
                    body.dataset.outlineOpen = "false";
                    outlineToggle?.setAttribute("aria-expanded", "false");
                };

                outlineToggle?.addEventListener("click", () => {
                    const open = body.dataset.outlineOpen !== "true";
                    body.dataset.outlineOpen = String(open);
                    outlineToggle.setAttribute("aria-expanded", String(open));
                });
                backdrop?.addEventListener("click", closeDrawers);
                document.addEventListener("keydown", (event) => event.key === "Escape" && closeDrawers());
                document.querySelectorAll("[data-outline-link]").forEach((link) => {
                    link.addEventListener("click", () => { body.dataset.outlineOpen = "false"; });
                });

                const outlineLinks = [...document.querySelectorAll("[data-outline-link]")];
                const sections = outlineLinks
                    .map((link) => document.getElementById(link.dataset.outlineLink))
                    .filter(Boolean);
                let ticking = false;

                const updateReadingState = () => {
                    const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
                    const progress = maxScroll > 0 ? Math.min(100, Math.max(0, window.scrollY / maxScroll * 100)) : 100;
                    document.documentElement.style.setProperty("--reading-progress", `${progress}%`);
                    document.querySelectorAll("[data-progress-label]").forEach((label) => {
                        label.textContent = `${Math.round(progress)}%`;
                    });

                    let active = sections[0];
                    for (const section of sections) {
                        if (section.getBoundingClientRect().top <= window.innerHeight * .32) active = section;
                        else break;
                    }
                    outlineLinks.forEach((link) => {
                        const current = active && link.dataset.outlineLink === active.id;
                        link.classList.toggle("active", Boolean(current));
                        if (current) link.setAttribute("aria-current", "location");
                        else link.removeAttribute("aria-current");
                    });
                    ticking = false;
                };

                window.addEventListener("scroll", () => {
                    if (!ticking) {
                        requestAnimationFrame(updateReadingState);
                        ticking = true;
                    }
                }, { passive: true });
                updateReadingState();
            })();
        </script>
    </body>
</html>
